# Deepgram API key — get yours free at https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Anthropic API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase — database and auth (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google OAuth — for "Continue with Google" on the login screen
# Create at: https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client ID → Desktop app
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Set to 'development' while building, 'production' for release
NODE_ENV=development

# ─── Paystack (web/Vercel deployment) ───────────────────────────────────────
# Public key — safe to expose in the bundle. Get from your Paystack dashboard.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
# Monthly plan code — create the plan in Paystack Dashboard → Plans → Add Plan
VITE_PAYSTACK_PLAN_CODE=PLN_xxxxxxxxxxxx
# These let the React bundle talk to Supabase directly (used by PaystackButton)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Supabase Edge Function secrets (NOT bundled — set via `supabase secrets set`) ─
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ─── Windows Code Signing (release builds only) ──────────────────────────────
# Once you obtain an Authenticode certificate (Azure Trusted Signing, SSL.com,
# Sectigo, DigiCert, etc.), set the two variables below and electron-builder
# will sign RETIAS-Setup.exe automatically during `npm run publish:win`.
#
# CSC_LINK can be:
#   • An absolute path to your .pfx / .p12 file (e.g. C:\certs\retias.pfx)
#   • A base64-encoded blob of the same file (useful for CI secrets)
#   • An https:// URL to the file
CSC_LINK=
CSC_KEY_PASSWORD=

# For EV certificates on a hardware token (YubiKey, SafeNet, etc.), leave the
# two vars above blank and instead set this so signtool uses the inserted token:
#   WIN_CSC_LINK=
#   WIN_CSC_KEY_PASSWORD=
# Hardware tokens usually require a custom sign hook — ping me if you go this route.

# For Azure Trusted Signing, leave CSC_LINK blank and instead populate:
#   AZURE_TENANT_ID=
#   AZURE_CLIENT_ID=
#   AZURE_CLIENT_SECRET=
#   AZURE_TRUSTED_SIGNING_ENDPOINT=
#   AZURE_TRUSTED_SIGNING_ACCOUNT=
#   AZURE_TRUSTED_SIGNING_PROFILE=
# (a separate sign hook script is needed for Azure — add when you're ready)

